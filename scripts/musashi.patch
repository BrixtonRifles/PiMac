+/* PiMac: the emulated 68882 (src/fpu/fpu68882.cpp). */
+extern int pimac_fpu_present;
+void pimac_fpu_op0(void); /* $F2xx: general, FScc/FDBcc/FTRAPcc, FBcc */
+void pimac_fpu_op1(void); /* $F3xx: FSAVE, FRESTORE */
+/* An FC 7 (CPU space) address that answers: the 68882's interface registers. */
+static inline int pimac_cpu_space_ok(uint address)
+{
+	return pimac_fpu_present && (address & 0xffffffe0) == 0x00022000;
+}
