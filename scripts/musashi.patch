+/* PiMac: the 68030 long bus fault frame (46 words), filled in from the
+ * fault the MMU reported (mac/mmu030.cpp). PC is the faulted instruction:
+ * RTE restarts it. */
+extern unsigned pimac_fault_address;
+extern unsigned pimac_fault_ssw;
+extern unsigned pimac_fault_data;
+
+static inline void m68ki_stack_frame_1011_fault(uint sr, uint vector, uint pc)
+{
+	int i;
+	for (i = 0; i < 9; i++)
+		m68ki_push_32(0);            /* $38: internal registers (18 words) */
+	m68ki_push_16(0);                /* $36: version, internal information */
+	m68ki_push_32(0);                /* $30: internal registers (3 words) */
+	m68ki_push_16(0);
+	m68ki_push_32(0);                /* $2C: data input buffer */
+	m68ki_push_32(0);                /* $28: internal registers */
+	m68ki_push_32(pimac_fault_address); /* $24: stage B address */
+	m68ki_push_32(0);                /* $1C: internal registers (4 words) */
+	m68ki_push_32(0);
+	m68ki_push_32(pimac_fault_data); /* $18: data output buffer */
+	m68ki_push_32(0);                /* $14: internal registers */
+	m68ki_push_32(pimac_fault_address); /* $10: data cycle fault address */
+	m68ki_push_16(0);                /* $0E: instruction pipe stage B */
+	m68ki_push_16(0);                /* $0C: instruction pipe stage C */
+	m68ki_push_16(pimac_fault_ssw);  /* $0A: special status word */
+	m68ki_push_16(0);                /* $08: internal register */
+	m68ki_push_16(0xb000 | (vector<<2));
+	m68ki_push_32(pc);
+	m68ki_push_16(sr);
+}
