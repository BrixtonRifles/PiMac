 	uint dar[16];      /* Data and Address Registers */
 	uint dar_save[16];  /* Saved Data and Address Registers (pushed onto the
 						   stack when a bus error occurs)*/
+	uint rollback;      /* PiMac: snapshot registers + CCR per instruction, so a
+						   68030 bus fault can restart the instruction (VM) */
+	uint ccr_save[5];   /* PiMac: X N Z V C at the start of the instruction */
 	uint ppc;		   /* Previous program counter */
