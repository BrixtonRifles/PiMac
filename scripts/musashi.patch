 #define m68ki_check_bus_error_trap() setjmp(m68ki_bus_error_jmp_buf)
@@ -1953,14 +1988,27 @@ static inline void m68ki_exception_bus_error(void)
 	/* Use up some clock cycles and undo the instruction's cycles */
 	USE_CYCLES(CYC_EXCEPTION[EXCEPTION_BUS_ERROR] - CYC_INSTRUCTION[REG_IR]);
 
-	for (i = 15; i >= 0; i--){
-		REG_DA[i] = REG_DA_SAVE[i];
+	/* PiMac: with the snapshot on (68030), the faulted instruction is
+	 * undone, and RTE from the format $B frame below restarts it; this is
+	 * how a page fault resumes under virtual memory. */
+	if(m68ki_cpu.rollback)
+	{
+		for (i = 15; i >= 0; i--){
+			REG_DA[i] = REG_DA_SAVE[i];
+		}
+		FLAG_X = m68ki_cpu.ccr_save[0];
+		FLAG_N = m68ki_cpu.ccr_save[1];
+		FLAG_Z = m68ki_cpu.ccr_save[2];
+		FLAG_V = m68ki_cpu.ccr_save[3];
+		FLAG_C = m68ki_cpu.ccr_save[4];
 	}
 
 	uint sr = m68ki_init_exception();
 
-	/* Note: This is implemented for 68010 only! */
-	m68ki_stack_frame_1000(REG_PPC, sr, EXCEPTION_BUS_ERROR);
+	if(CPU_TYPE_IS_EC020_PLUS(CPU_TYPE))
+		m68ki_stack_frame_1011_fault(sr, EXCEPTION_BUS_ERROR, REG_PPC);
+	else
+		m68ki_stack_frame_1000(REG_PPC, sr, EXCEPTION_BUS_ERROR);
 
 	m68ki_jump_vector(EXCEPTION_BUS_ERROR);
 
